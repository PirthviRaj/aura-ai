# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-long-random-string

# Optional AI
OPENAI_API_KEY=

# Real OAuth — create free apps, then paste IDs/secrets below.
# Callback URL for all providers:
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/github
#   http://localhost:3000/api/auth/callback/azure-ad
# Production: https://YOUR_DOMAIN/api/auth/callback/<provider>

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub → Settings → Developer settings → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Azure Portal → App registrations → New registration (Accounts in any org + personal)
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common

# Legacy optional Supabase (not required for NextAuth OAuth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
